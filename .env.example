SITE_BASE_URL=https://your-domain.com
MONITORING_MODE=auto
UNATTENDED_MODE=true
CONTENT_REVIEW_MODE=unattended
CONTENT_SOURCE_RESULT_LIMIT=4
CONTENT_PAGE_COUNT_TARGET=10

# Optional AI draft provider
CONTENT_AI_PROVIDER=heuristic
CONTENT_AI_ENDPOINT=
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=

# Optional Firecrawl CLI evidence layer
FIRECRAWL_ENABLED=false
FIRECRAWL_CLI_BIN=firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
FIRECRAWL_TIMEOUT_MS=120000
FIRECRAWL_SEARCH_LIMIT=8
FIRECRAWL_MAP_LIMIT=18
FIRECRAWL_DEEP_PAGE_LIMIT=6
FIRECRAWL_EXCERPT_CHARS=1200
FIRECRAWL_WAIT_FOR_MS=1500
FIRECRAWL_AGENT_ENABLED=false
FIRECRAWL_AGENT_MODEL=spark-1-mini
FIRECRAWL_AGENT_MAX_CREDITS=80

# Optional commercial modules
CONTACT_CTA_URL=
SPONSORED_SLOT_URL=

# Real lead capture + delivery backend
DELIVERY_API_BASE_URL=https://api.your-domain.com
TURNSTILE_SITE_KEY=
TURNSTILE_REQUIRED=false
CLOUDFLARE_R2_BUCKET=automiora-site-assets-prod
CLOUDFLARE_PAGES_PROJECT=automiora-site
RELEASE_SITE_SLUG=ai-video-workflow-short-form-demo
RELEASE_ASSET_SLUG=prompt-pack
AUTO_RELEASE_ENABLED=false
AUTO_RELEASE_ON_GATE_PASS=false

# Preferred: user OAuth credentials for GSC + GA4
GOOGLE_OAUTH_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-desktop-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:4815/oauth2/callback

# Optional fallback: service account credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GSC_SITE_URL=sc-domain:your-domain.com
GA4_PROPERTY_ID=123456789
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_CONVERSION_EVENTS=generate_lead,sign_up,purchase
GSC_LOOKBACK_DAYS=30
GA4_LOOKBACK_DAYS=30

# Real SEO submit adapters
INDEXNOW_KEY=
INDEXNOW_HOST=your-domain.com
INDEXNOW_KEY_LOCATION=https://your-domain.com/your-indexnow-key.txt

# Real delivery / commercial backend
